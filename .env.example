# Copy to .env.local for Next.js and export into your shell for command-line scripts.
# Supabase free PostgreSQL connection string (pooled URL recommended on Vercel).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Public URL after deployment; localhost while developing.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Never use an official institution's name without approval.
ISSUER_NAME=Demonstration Training Organization
ISSUER_APPROVED=false
# Required secret: openssl rand -hex 32
SECURITY_PEPPER=replace-with-at-least-32-random-characters
# Bootstrap only; unset after first admin created.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Holder ownership challenges, optional until SMTP configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
